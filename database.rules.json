{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && auth.uid === $uid",
        ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && auth.uid === $uid",
        ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid"
      }
    },
    "usernames": {
      "$username": {
        ".read": true,
        ".write": "auth != null && auth.token.email_verified === true && ((!data.exists() && newData.val() === auth.uid) || data.val() === auth.uid)"
      }
    }
  }
}
