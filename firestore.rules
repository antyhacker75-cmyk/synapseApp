rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Authentication creates these documents automatically at users/{uid}.
    // Signed-in users can read profiles; only each account owner can modify its own data.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if owns(uid);
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if owns(uid);
    }

    // Add explicit rules for other collections when their repositories are migrated.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
